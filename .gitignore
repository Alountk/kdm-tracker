.gradle/
build/
.idea/
*.iml
.env
local.properties
.kotlin/
out/

# Server H2 file-database artifacts (the :data/ directory is a tracked KMP module)
**/data/*.mv.db
**/data/*.trace.db
**/data/*.lock.db

# Untracked copyrighted source assets (card PDFs, art, rules reference material).
# Consumed by tools/content-ingest; never committed.
external-assets/
external-assets

# Python bytecode from the tools/ scripts.
__pycache__/
*.py[cod]

# Local design cache (Stitch HTML/PNG exports); the specs under
# docs/superpowers/ are the tracked record.
.superpowers/
