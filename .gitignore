# --- Build & tooling -------------------------------------------------------
.gradle/
build/
.kotlin/
out/
local.properties

# Eclipse/IDE compile output (copies sources into bin/; Gradle uses build/).
bin/

# --- IDEs & editors --------------------------------------------------------
.idea/
*.iml
.vscode/
.fleet/
*.swp
*.swo
*~

# --- OS noise --------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Runtime, logs & crashes ----------------------------------------------
*.log
*.hprof
captures/
.externalNativeBuild/
.cxx/

# Server H2 file-database artifacts (the :data/ directory is a tracked KMP module)
**/data/*.mv.db
**/data/*.trace.db
**/data/*.lock.db

# Merge/rebase leftovers
*.orig
*.rej

# Secrets / local env
.env

# Untracked copyrighted source assets (card PDFs, art, rules reference material).
# Consumed by tools/content-ingest; never committed.
external-assets/
external-assets

# Python bytecode and virtualenvs from the tools/ scripts.
__pycache__/
*.py[cod]
.venv/
venv/

# Local agent-tooling state (worktrees, caches); never committed.
.kilo/
.kilocode/

# Transient session handoff notes; consumed and deleted after the handoff.
/HANDOFF.md
