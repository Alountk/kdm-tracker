<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay: targetSdk 36 blocks cleartext traffic, so the development hub reached at
  http://10.0.2.2:8080 (DEFAULT_SYNC_BASE_URL) is unreachable by default. This overlay re-enables
  cleartext for debug builds only; the release manifest is untouched and stays HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
